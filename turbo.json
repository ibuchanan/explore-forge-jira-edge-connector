{
  "$schema": "https://turbo.build/json-schema.json",
  "globalDependencies": ["tsconfig.json", "biome.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "test": {
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "cache": true,
      "env": ["CI"]
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "lint:check": {
      "outputs": [],
      "cache": true
    },
    "lint:fix": {
      "outputs": [],
      "cache": false
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "format:check": {
      "outputs": [],
      "cache": true
    },
    "check": {
      "outputs": [],
      "cache": true,
      "dependsOn": ["lint", "format:check", "typecheck"]
    },
    "typecheck": {
      "outputs": [],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "changelog": {
      "outputs": [],
      "cache": false
    },
    "generate": {
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "generate:openapi": {
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "forge:deploy": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "forge:install": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "forge:uninstall": {
      "cache": false,
      "persistent": false
    },
    "forge:upgrade": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "forge:scopes": {
      "cache": false,
      "persistent": false
    },
    "test:api": {
      "cache": false
    },
    "todo": {
      "cache": false
    }
  }
}
