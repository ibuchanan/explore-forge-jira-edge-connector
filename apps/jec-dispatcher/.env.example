# Copy this file to .env in apps/jec-dispatcher before running the Forge scripts.
# Do not commit the real .env file.

# Atlassian site slug used by the Forge install/upgrade/uninstall scripts.
# Example: for https://example.atlassian.net, use SITENAME=example.
SITENAME=your-site-name

# Atlassian product to install the Forge app into.
# This app is a Jira Service Management/Jira app, so jira is the expected value.
PRODUCT=jira

# Key ID expected in signed JEC/on-premise callback requests.
# The callback Authorization header must use the same keyId value.
CALLBACK_HMAC_KEY_ID=development-key

# Shared HMAC secret used to verify signed JEC/on-premise callback requests.
# Replace this with a high-entropy secret for any shared or deployed environment.
CALLBACK_HMAC_SECRET=development-only-secret-change-me
