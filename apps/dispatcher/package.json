{
  "name": "explore-forge-jira-edge-connector",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "scripts": {
    "build": "tsc",
    "changelog": "echo 'Not implemented'",
    "check": "npm run test && npm run lint && npm run format:check && npm run typecheck",
    "clean": "rm -rf ./dist",
    "dev": "tsdown --watch",
    "forge:deploy": "source .env && forge deploy --environment $FORGE_ENVIRONMENT",
    "forge:install": "source .env && forge install --site \"$SITENAME.atlassian.net\" --product $PRODUCT --environment $FORGE_ENVIRONMENT --non-interactive",
    "forge:lint": "forge lint",
    "forge:uninstall": "source .env && forge uninstall --site \"$SITENAME.atlassian.net\" --product $PRODUCT",
    "forge:upgrade": "source .env && forge install --upgrade --site \"$SITENAME.atlassian.net\" --product $PRODUCT --environment $FORGE_ENVIRONMENT --non-interactive",
    "format": "biome format --write",
    "format:check": "biome format",
    "generate": "echo 'Not implemented'",
    "lint": "npm run lint:check && forge lint",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "prepare": "echo 'Not implemented'",
    "preview": "echo 'Not implemented'",
    "start": "echo 'Not implemented'",
    "test": "vitest run",
    "test:coverage": "echo 'Not implemented'",
    "test:watch": "vitest watch",
    "todo": "grep -rn 'TODO' --exclude='package.json' . --color=auto || echo 'No TODOs found!'",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "markdown-it": "^14.1.1"
  },
  "dependencies": {
    "@forge/api": "^7.2",
    "@forge/bridge": "^5.16",
    "@forge/kvs": "^1.6",
    "@forge/react": "^11.16",
    "@forge/resolver": "^1.8",
    "forge-ahead": "^0.3.0",
    "react": "^18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "25",
    "archunit": "^2.3",
    "tsdown": "^0.22",
    "typescript": "^5.9",
    "vitest": "^4.1"
  }
}
