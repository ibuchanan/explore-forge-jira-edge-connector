# Copy this file to .env in apps/dispatcher before running the Forge scripts.
# Do not commit the real .env file.

# Atlassian site slug used by the Forge install/upgrade/uninstall scripts.
# Example: for https://example.atlassian.net, use SITENAME=example.
SITENAME=your-site-name

# Atlassian product to install the Forge app into.
# This app is a Jira Service Management app, so jira is the expected value.
PRODUCT=jira

# Forge environment to deploy/install into.
# Use "development" for local dev, "staging" or "production" for shared environments.
FORGE_ENVIRONMENT=development
