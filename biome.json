{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!.projen",
      "!**/coverage",
      "!**/dist",
      "!packages/forge-ahead/src/apis"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  }
}
