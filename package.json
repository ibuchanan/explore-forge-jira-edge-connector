{
  "name": "explore-forge-jira-edge-connector-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "changelog": "turbo run changelog",
    "check": "turbo run check",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "forge:deploy": "turbo run forge:deploy",
    "forge:register": "turbo run forge:register",
    "forge:install": "turbo run forge:install",
    "forge:uninstall": "turbo run forge:uninstall",
    "forge:upgrade": "turbo run forge:upgrade",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "generate": "turbo run generate",
    "generate:openapi": "turbo run generate:openapi",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "todo": "turbo run todo",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.10.0"
  },
  "packageManager": "npm@11.12.1"
}
