        "./dist/jira/devops.d.mts"
      ],
      "jira/platform-2": [
        "./dist/apis/jira-platform-2.d.mts"
      ],
      "jira/platform-3": [
        "./dist/apis/jira-platform-3.d.mts"
      ],
      "jira/servicedesk": [
        "./dist/apis/jira-servicedesk.d.mts"
      ],
      "jira/software": [
        "./dist/apis/jira-software.d.mts"
      ]
    }
  },
  "bin": {
    "actiontypes": "./dist/actiontypes.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "changelog": "git cliff",
    "check": "npm run test && npm run lint && npm run format:check && npm run typecheck",
    "check:arch": "vitest test/architecture.test.ts",
    "clean": "rm -rf ./dist",
    "dev": "tsdown --watch",
    "format": "biome format --write",
    "format:check": "biome format",
    "generate": "npm run generate:openapi",
    "generate:openapi": "openapi-typescript",
    "lint": "npm run lint:check",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "preview": "echo 'Not implemented'",
    "start": "echo 'Not implemented'",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "todo": "grep -rn 'TODO' --exclude='package.json' . --color=auto || echo 'No TODOs found!'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge/api": "^8.0",
    "@forge/kvs": "^2.0",
    "jmespath": "^0.16",
    "jose": "^6.2",
    "neverthrow": "^8.2",
    "sort-package-json": "^4.0",
    "yaml": "^2.9"
  },
  "devDependencies": {
    "@redocly/cli": "^2.35",
    "@types/jmespath": "^0.15",
    "@vitest/coverage-v8": "^4.1",
    "archunit": "^2.3",
    "openapi-typescript": "^7.8",
    "tsdown": "^0.22"
  }
